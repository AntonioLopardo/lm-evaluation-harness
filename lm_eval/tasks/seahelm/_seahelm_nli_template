dataset_path: aisingapore/NLR-NLI
output_type: multiple_choice
test_split: eval
process_docs: !function utils.process_nli_docs
doc_to_text: "{{sentence1}}\nQuestion: {{sentence2}} True, False, or Neither?\nAnswer:"
doc_to_target: !function utils.nli_doc_to_target
doc_to_choice:
  - "True"
  - "False"
  - "Neither"
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
