dataset_path: aisingapore/NLR-Causal-Reasoning
output_type: multiple_choice
test_split: eval
process_docs: !function utils.process_causal_docs
doc_to_text: "{{premise}}\nQuestion: What is the {{question}}?\nA. {{choice1}}\nB. {{choice2}}\nAnswer:"
doc_to_target: !function utils.causal_doc_to_target
doc_to_choice:
  - "A"
  - "B"
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
