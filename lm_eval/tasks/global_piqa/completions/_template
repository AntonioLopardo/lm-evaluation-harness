dataset_path: /var/tmp/soar/datasets/global_piqa_c1862c45   # build-env.sh rewrites this to its local snapshot of revision c1862c45 (2025-10-29), the release the paper evaluated; the dataset was replaced on 2026-05-06
output_type: multiple_choice
test_split: test
doc_to_text: prompt
doc_to_target: label
doc_to_choice: "{{[solution0, solution1]}}"
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
  - metric: acc_norm
    aggregation: mean
    higher_is_better: true
  - metric: acc_bytes
    aggregation: mean
    higher_is_better: true
metadata:
  version: 1.0
